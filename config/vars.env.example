# ============================================================
# VPN 部署变量
# 用法：复制为 config/vars.env 并填写（vars.env 已被 .gitignore 忽略，不会提交）
# ============================================================

# 远程服务器公网地址（IPv4 或 IPv6 均可，必填）
#   IPv6 例：2001:db8::1     IPv4 例：1.2.3.4
SERVER_PUBLIC_ADDR=""

# SSH 用户名（默认 root）
SSH_USER="root"

# 隧道网段与 IP（可自定义，避免与本地网络冲突）
TUNNEL_SUBNET="10.8.0.0/24"
SERVER_TUN_IP="10.8.0.1"
CLIENT_TUN_IP="10.8.0.2"

# 端口
WG_PORT="51820"          # WireGuard UDP 监听端口
MIXED_PORT="7890"        # mihomo 代理端口（只监听隧道 IP）

# Clash 自建节点显示名
SELF_NODE_NAME="自建-远程IPv6出口"
